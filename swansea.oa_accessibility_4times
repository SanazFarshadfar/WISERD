DROP TABLE IF EXISTS swansea.oa_accessibility_4times;

CREATE TABLE swansea.oa_accessibility_4times AS

SELECT
    s.oa21 AS oa21cd,

    COUNT(*) AS residential_postcodes,
    SUM(s.population) AS population,

    ROUND(
        SUM(a.access_0700::numeric * s.population) /
        NULLIF(SUM(s.population), 0),
        2
    ) AS access_0700,

    ROUND(
        SUM(a.access_0800::numeric * s.population) /
        NULLIF(SUM(s.population), 0),
        2
    ) AS access_0800,

    ROUND(
        SUM(a.access_1300::numeric * s.population) /
        NULLIF(SUM(s.population), 0),
        2
    ) AS access_1300,

    ROUND(
        SUM(a.access_1800::numeric * s.population) /
        NULLIF(SUM(s.population), 0),
        2
    ) AS access_1800

FROM swansea.accessibility_all_swansea_postcodes a

JOIN swansea.summary_postcode_lsoa_oa_population s
    ON REPLACE(UPPER(TRIM(a.postcode)), ' ', '') =
       REPLACE(UPPER(TRIM(s.postcode)), ' ', '')

WHERE s.population > 0
  AND s.oa21 IS NOT NULL

GROUP BY s.oa21

ORDER BY s.oa21;
